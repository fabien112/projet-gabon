# DataExpert — pack JAR (site client)
# Copier en .env puis adapter.

SERVER_PORT=8080

# Login unique partagé (tous les utilisateurs)
APP_LOGIN_USER=admin
APP_LOGIN_PASSWORD=changeme

# Superadmin (seul à voir Config)
APP_SUPERADMIN_USER=superadmin
APP_SUPERADMIN_PASSWORD=SuperAdmin2026

# Connexion DSS Professional
DSS_PROTOCOL=https
DSS_HOST=192.168.10.21
DSS_PORT=443
DSS_USERNAME=votre_user_dss
DSS_PASSWORD=votre_mot_de_passe

DSS_VERIFY_SSL=false
DSS_CONNECT_TIMEOUT=10s
DSS_READ_TIMEOUT=15s
DSS_KEEP_ALIVE_INTERVAL=25s

DSS_MQ_ENABLED=true
DSS_LOGIN_TYPE=2
DSS_AUTO_LOGIN=true
DSS_PASSENGER_FLOW_POLL_ENABLED=true
DSS_PASSENGER_FLOW_POLL_INTERVAL=60s

DSS_LOG_LEVEL=INFO
DSS_HTTP_LOG_LEVEL=WARN

# Base H2 locale (par défaut) — rien à installer
# Pour MySQL plus tard, décommenter :
# DB_URL=jdbc:mysql://localhost:3306/dss?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Africa/Libreville
# DB_USER=root
# DB_PASSWORD=secret
# DB_DRIVER=com.mysql.cj.jdbc.Driver
