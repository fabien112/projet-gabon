# === DataExpert — config site client ===
# Copier ce fichier en .env puis adapter les valeurs.
# Ne jamais committer le .env réel.
#
# Production (VPS, après git clone) :
#   cp .env.example .env
#   nano .env
#   bash deploy.sh
#
# Le script construit les images, les publie si DOCKER_REGISTRY est renseigné,
# les récupère, puis démarre web + api + PostgreSQL (données dans un volume Docker).
#
# Mode alternatif sans Docker : JAR dist-client/ (Java 21 + H2)

# --- Images Docker (optionnel) ---
# Vide = images locales, pas de push. Pour publier puis redéployer par pull :
#   docker login
#   DOCKER_REGISTRY=docker.io/votrecompte
#   IMAGE_TAG=1.0.0
DOCKER_REGISTRY=
IMAGE_TAG=latest

# Login unique partagé (tous les utilisateurs)
APP_LOGIN_USER=admin
APP_LOGIN_PASSWORD=PeopleCounting2026

# Superadmin (seul à voir Config)
APP_SUPERADMIN_USER=superadmin
APP_SUPERADMIN_PASSWORD=SuperAdmin2026

# --- Docker Compose : ports publics ---
WEB_PORT=80
# pgAdmin : localhost uniquement (127.0.0.1) — pas d'exposition réseau
PGADMIN_PORT=5050
# POSTGRES_PORT : utilisé seulement avec docker-compose.migrate-local.yml (migration H2)
# POSTGRES_PORT=5432
TZ=Africa/Libreville
COMPOSE_PROJECT_NAME=dataexpert

# JVM API (conteneur Docker)
JAVA_OPTS=-Xms256m -Xmx512m

# --- PostgreSQL (service db) ---
POSTGRES_DB=dss
POSTGRES_USER=dss_user
POSTGRES_PASSWORD=change_me_in_production

# --- pgAdmin (service pgadmin) — http://serveur:5050 ---
PGADMIN_EMAIL=admin@dataexpert.local
PGADMIN_PASSWORD=change_me_pgadmin

# Profil Spring Boot (dev local hors Docker ; ignoré par docker-compose)
SPRING_PROFILES_ACTIVE=postgres
DB_URL=jdbc:postgresql://localhost:5432/dss
DB_USER=dss_user
DB_PASSWORD=change_me_in_production
DB_DRIVER=org.postgresql.Driver
FLYWAY_ENABLED=true
H2_CONSOLE=false

# --- Connexion DSS Professional (réseau local du client) ---
DSS_PROTOCOL=https
DSS_HOST=192.168.10.21
DSS_PORT=443
DSS_USERNAME=votre_user_dss
DSS_PASSWORD=votre_mot_de_passe

DSS_VERIFY_SSL=false
DSS_CONNECT_TIMEOUT=10s
DSS_READ_TIMEOUT=15s
DSS_KEEP_ALIVE_INTERVAL=25s

DSS_MQ_ENABLED=true
DSS_LOGIN_TYPE=2
DSS_AUTO_LOGIN=true
DSS_PASSENGER_FLOW_POLL_ENABLED=true
# Toutes les 5s : DSS → base (nouveaux créneaux seulement) → événement SSE vers le front
DSS_PASSENGER_FLOW_POLL_INTERVAL=5s

# Import historique seulement si la base est vide (le poll gère le jour en cours)
DSS_STARTUP_FULL_SYNC_ENABLED=false
DSS_STARTUP_FULL_SYNC_DAYS=30
DSS_AUTO_MISSING_SYNC_ON_STARTUP=true

DSS_LOG_LEVEL=INFO
DSS_HTTP_LOG_LEVEL=WARN

# --- Worker sync (phase 2, service séparé) ---
# Compte DSS dédié obligatoire si worker activé en parallèle de api
# DSS_WORKER_USERNAME=
# DSS_WORKER_PASSWORD=
