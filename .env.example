# === DataExpert — production (VPS) ===
# Après le clone :  cp .env.example .env
# L'IP publique du VPS ne va PAS dans ce fichier.
# Tu ouvres l'application dans le navigateur : http://IP_PUBLIQUE_DU_VPS/
#
# À adapter sur le VPS (obligatoire) :
#   DSS_HOST      = IP du serveur Dahua DSS, vue DEPUIS le VPS (réseau local)
#                   Ce n'est PAS l'IP publique du VPS.
#   DSS_USERNAME  = compte DSS Professional
#   DSS_PASSWORD  = mot de passe DSS Professional
#
# Le reste (app, Postgres, pgAdmin) est déjà prêt pour la production.

# --- Images ---
# Vide = construction et exécution locales sur le VPS (recommandé ici).
# Pour tirer depuis GHCR : DOCKER_REGISTRY=ghcr.io/fabien112
DOCKER_REGISTRY=
IMAGE_TAG=latest

# --- Accès application (navigateur) ---
APP_LOGIN_USER=gabtrack
APP_LOGIN_PASSWORD=QEhYupfPjtFJAjrzA7Pa6ETcYSbX
APP_SUPERADMIN_USER=gabtrack_admin
APP_SUPERADMIN_PASSWORD=7M2dvXhvJY2QL8beG7F2ZQhWKZDS

# --- Ports ---
# L'app écoute sur le VPS : http://IP_PUBLIQUE_DU_VPS:WEB_PORT/
WEB_PORT=80
PGADMIN_PORT=5050
TZ=Africa/Libreville
COMPOSE_PROJECT_NAME=dataexpert
JAVA_OPTS=-Xms256m -Xmx512m

# --- PostgreSQL (volume Docker dss_pg_data, aucun port public) ---
POSTGRES_DB=dss
POSTGRES_USER=dss_app
POSTGRES_PASSWORD=4sbw32CMvdLXerUoRuLppLz6DymD

# --- pgAdmin (uniquement 127.0.0.1:5050 sur le VPS, tunnel SSH) ---
PGADMIN_EMAIL=pgadmin@gabtrack.local
PGADMIN_PASSWORD=zHfYLBTNGTH8QaAFojGBSdbZZdiC

# Profil Spring (ignoré par docker-compose qui force postgres,docker)
SPRING_PROFILES_ACTIVE=postgres
DB_URL=jdbc:postgresql://localhost:5432/dss
DB_USER=dss_app
DB_PASSWORD=4sbw32CMvdLXerUoRuLppLz6DymD
DB_DRIVER=org.postgresql.Driver
FLYWAY_ENABLED=true
H2_CONSOLE=false

# --- Dahua DSS (réseau joignable depuis le VPS, pas l'IP publique du VPS) ---
DSS_PROTOCOL=https
DSS_HOST=192.168.10.21
DSS_PORT=443
DSS_USERNAME=Fabien
DSS_PASSWORD=Libreville2026

DSS_VERIFY_SSL=false
DSS_CONNECT_TIMEOUT=10s
DSS_READ_TIMEOUT=15s
DSS_KEEP_ALIVE_INTERVAL=25s

DSS_MQ_ENABLED=true
DSS_LOGIN_TYPE=2
DSS_AUTO_LOGIN=true
DSS_PASSENGER_FLOW_POLL_ENABLED=true
DSS_PASSENGER_FLOW_POLL_INTERVAL=5s

DSS_STARTUP_FULL_SYNC_ENABLED=false
DSS_STARTUP_FULL_SYNC_DAYS=30
DSS_AUTO_MISSING_SYNC_ON_STARTUP=true

DSS_LOG_LEVEL=INFO
DSS_HTTP_LOG_LEVEL=WARN
