# === DataExpert — config site client ===
# Copier ce fichier en .env puis adapter les valeurs.
# Ne jamais committer le .env réel.
#
# Déploiement production : Docker Compose (docker compose up -d --build)
# Mode alternatif        : JAR dist-client/ (Java 21 + H2)

# Login unique partagé (tous les utilisateurs)
APP_LOGIN_USER=admin
APP_LOGIN_PASSWORD=PeopleCounting2026

# Superadmin (seul à voir Config)
APP_SUPERADMIN_USER=superadmin
APP_SUPERADMIN_PASSWORD=SuperAdmin2026

# --- Docker Compose : ports publics ---
WEB_PORT=80
PGADMIN_PORT=5050
# POSTGRES_PORT=5432
# API_PORT=8080

# --- PostgreSQL (service db) ---
POSTGRES_DB=dss
POSTGRES_USER=dss_user
POSTGRES_PASSWORD=change_me_in_production

# --- pgAdmin (service pgadmin) — http://serveur:5050 ---
PGADMIN_EMAIL=admin@dataexpert.local
PGADMIN_PASSWORD=change_me_pgadmin

# Profil Spring Boot (dev local hors Docker ; ignoré par docker-compose)
SPRING_PROFILES_ACTIVE=postgres
DB_URL=jdbc:postgresql://localhost:5432/dss
DB_USER=dss_user
DB_PASSWORD=change_me_in_production
DB_DRIVER=org.postgresql.Driver
FLYWAY_ENABLED=true
H2_CONSOLE=false

# --- Connexion DSS Professional (réseau local du client) ---
DSS_PROTOCOL=https
DSS_HOST=192.168.10.21
DSS_PORT=443
DSS_USERNAME=votre_user_dss
DSS_PASSWORD=votre_mot_de_passe

DSS_VERIFY_SSL=false
DSS_CONNECT_TIMEOUT=10s
DSS_READ_TIMEOUT=15s
DSS_KEEP_ALIVE_INTERVAL=25s

DSS_MQ_ENABLED=true
DSS_LOGIN_TYPE=2
DSS_AUTO_LOGIN=true
DSS_PASSENGER_FLOW_POLL_ENABLED=true
DSS_PASSENGER_FLOW_POLL_INTERVAL=60s

# Sync historique au 1er démarrage (optionnel)
DSS_STARTUP_FULL_SYNC_ENABLED=false
DSS_STARTUP_FULL_SYNC_DAYS=30

DSS_LOG_LEVEL=INFO
DSS_HTTP_LOG_LEVEL=WARN

# --- Worker sync (phase 2, service séparé) ---
# Compte DSS dédié obligatoire si worker activé en parallèle de api
# DSS_WORKER_USERNAME=
# DSS_WORKER_PASSWORD=
