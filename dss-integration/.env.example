# Copier ce fichier en .env et renseigner les valeurs DSS.
# Sous Windows PowerShell :
#   $env:DSS_HOST="192.168.1.147"
#   $env:DSS_USERNAME="system"
#   $env:DSS_PASSWORD="votre-mot-de-passe"
# Puis lancer : .\mvnw.cmd spring-boot:run

# Java (JDK 21 requis)
# JAVA_HOME=C:\Program Files\Java\jdk-21.0.11

# Serveur Spring Boot
SERVER_PORT=8080

# Connexion DSS Professional
DSS_PROTOCOL=https
DSS_HOST=
DSS_PORT=443
DSS_USERNAME=
DSS_PASSWORD=

# Certificat auto-signé DSS (false = accepter le certificat)
DSS_VERIFY_SSL=false

# Timeouts HTTP
DSS_CONNECT_TIMEOUT=10s
DSS_READ_TIMEOUT=15s
DSS_KEEP_ALIVE_INTERVAL=25s

# Logs (DEBUG pour tracer les appels HTTP DSS)
DSS_LOG_LEVEL=INFO
DSS_HTTP_LOG_LEVEL=WARN
