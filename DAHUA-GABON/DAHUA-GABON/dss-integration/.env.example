

# Serveur Spring Boot
SERVER_PORT=8080

# Connexion DSS Professional (Gabon)
DSS_PROTOCOL=https
DSS_HOST=192.168.10.21
DSS_PORT=443
DSS_USERNAME=Fabien
DSS_PASSWORD=Libreville2026

# Certificat auto-signé DSS (false = accepter le certificat)
DSS_VERIFY_SSL=false

# Timeouts HTTP
DSS_CONNECT_TIMEOUT=10s
DSS_READ_TIMEOUT=15s
DSS_KEEP_ALIVE_INTERVAL=25s

# Logs (DEBUG pour tracer les appels HTTP DSS en cas d'erreur)
DSS_LOG_LEVEL=INFO
DSS_HTTP_LOG_LEVEL=WARN

# ActiveMQ — push temps réel (People Counting / alarmes)
DSS_MQ_ENABLED=true

# 1=normal, 2=multi-site (recommandé si session déjà ouverte)
DSS_LOGIN_TYPE=2

# Login + MQ automatiquement au démarrage (true recommandé)
DSS_AUTO_LOGIN=true

# Poll HTTP des stats People Counting (comme l'UI/Excel) — logs >>> [FLOW]
DSS_PASSENGER_FLOW_POLL_ENABLED=true
DSS_PASSENGER_FLOW_POLL_INTERVAL=60s
